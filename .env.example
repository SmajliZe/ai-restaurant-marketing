# Root environment file consumed by docker-compose.
# Copy to .env before running `docker compose up`. Never commit the copy.
#
# Each app also has its own .env.example for running it outside Docker.

# --- Postgres -------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=restaurant_ai
POSTGRES_PORT=5432

# --- Host ports -----------------------------------------------------------------
WEB_PORT=3000
AI_SERVICE_PORT=8000

# --- Services --------------------------------------------------------------------
LOG_LEVEL=INFO

# Placeholder only; the scaffold starts fine with this left empty.
OPENAI_API_KEY=
