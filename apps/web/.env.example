# Copy to .env.local for local development. Never commit the filled-in copy.
# When running through docker-compose these values come from the root .env instead.

# Public origin the browser uses to reach this app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the FastAPI service, resolved server-side.
# Inside docker-compose use the service name: http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000

# Postgres connection string used by server-side code and by drizzle-kit.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/restaurant_ai

# Signs session cookies. Generate your own with: openssl rand -base64 32
AUTH_SECRET=
