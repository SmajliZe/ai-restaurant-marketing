# Copy to .env for local development. Never commit the filled-in copy.
# When running through docker-compose these values come from the root .env instead.

APP_NAME=ai-service
APP_ENV=development
LOG_LEVEL=INFO

# Postgres connection string.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/restaurant_ai

# Placeholder only - use a real key from your own OpenAI account locally.
OPENAI_API_KEY=sk-replace-me

# Comma-separated list; empty disables the CORS middleware entirely.
CORS_ALLOW_ORIGINS=http://localhost:3000
