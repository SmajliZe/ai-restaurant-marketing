# Copy to .env for local development. Never commit the filled-in copy.
# When running through docker-compose these values come from the root .env instead.

APP_NAME=ai-service
APP_ENV=development
LOG_LEVEL=INFO

# Postgres connection string.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/restaurant_ai

# Gemini API key. Create one for free at https://aistudio.google.com/apikey -
# the Flash models run on the free tier and no credit card is required.
GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated list; empty disables the CORS middleware entirely.
CORS_ALLOW_ORIGINS=http://localhost:3000
